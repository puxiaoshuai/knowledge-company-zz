PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB
MONGODB_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# Snowflake (snowflake-id: mid 0–1023)
SNOWFLAKE_WORKER_ID=1
# Epoch offset ms; default ≈ 2024-01-01
SNOWFLAKE_OFFSET=1704067200000

# JWT 鉴权。两个 secret 必须不同，否则 access 令牌可当 refresh 用。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# access 过期前也能即时失效：登出 / 禁用 / 强制下线靠 kh_user.token_version 自增实现，
# 因此 JWT_ACCESS_EXPIRES_IN 只决定「令牌最长存活多久」，不再是吊销的生效延迟。
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-hex
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-byte-hex
JWT_REFRESH_EXPIRES_IN=7d

# Redis：邮箱激活 token / 重发冷却。
# 只影响注册、激活、重发三个接口；登录、刷新、文档全链路都不依赖它，
# 所以 REDIS_ENABLED=false 或 Redis 掉线时其余功能照常工作。
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# 留空 = 无密码（与 docker-compose 的 redis 服务一致）
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000

# 邮件（SMTP）。MAIL_HOST 留空 = 不报错，激活链接改打到日志（开发期降级），
# 日志里搜 EMAIL_VERIFY_LINK 即可拿到链接。
# 465 端口配 MAIL_SECURE=true；587 走 STARTTLS 配 false。
# MAIL_PASS 对 QQ / 163 这类邮箱填的是「授权码」而不是登录密码。
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
# 发件人写法：`显示名 <地址@域>`，或只写地址。
# 注意别写成 "显示名" <地址> —— dotenv 会在引号处截断，把地址丢掉。
MAIL_FROM="Knowledge Hub <no-reply@localhost>"

# 激活邮件。EMAIL_VERIFY_URL 是邮件链接的完整基地址（?token= 由代码拼）；
# 日后有了前端激活页，把它指向前端页面即可，不必改代码。
EMAIL_VERIFY_URL=http://localhost:3000/auth/verify-email
EMAIL_VERIFY_TOKEN_TTL_SECONDS=86400
EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=60
